--Now we see that results is not good.
--We will use UPPER to convert lower case to upper case.
--We will use TRIM to remove
--unwanted spaces from the beginning and end of a text
--(Data standardization & consistency)
SELECT DISTINCT
gen,
CASE
WHEN UPPER(TRIM(gen)) = 'F' THEN 'Female'
WHEN UPPER(TRIM(gen)) = 'M' THEN 'Male'
WHEN UPPER(TRIM(gen)) IS NULL THEN 'N/A'
WHEN UPPER(TRIM(gen)) = '' THEN 'N/A'
WHEN UPPER(TRIM(gen)) = 'FEMALE' THEN 'Female'
WHEN UPPER(TRIM(gen)) = 'MALE'   THEN 'Male'
ELSE 'gen'
END AS gen
FROM bronze.erp_cust_az12;
-----------------------------
--Merging created quries:
SELECT
CASE
WHEN cid LIKE 'NAS%' THEN SUBSTRING(cid,4,LEN(cid))
ELSE cid
END AS cid,
CASE
WHEN bdate > GETDATE() THEN NULL
ELSE bdate
END AS bdate,
CASE
WHEN UPPER(TRIM(gen)) = 'F' THEN 'Female'
WHEN UPPER(TRIM(gen)) = 'M' THEN 'Male'
WHEN UPPER(TRIM(gen)) IS NULL THEN 'N/A'
WHEN UPPER(TRIM(gen)) = '' THEN 'N/A'
WHEN UPPER(TRIM(gen)) = 'FEMALE' THEN 'Female'
WHEN UPPER(TRIM(gen)) = 'MALE'   THEN 'Male'
ELSE 'gen'
END AS gen
FROM bronze.erp_cust_az12;
